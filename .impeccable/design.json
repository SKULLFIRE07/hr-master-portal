  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled portal action.",
      "html": "<button class=\"ds-primary\">Open Darwinbox</button>",
      "css": ".ds-primary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;box-sizing:border-box;min-height:42px;padding:9px 15px;border:1px solid var(--border,#e3e7ee);border-radius:7px;background:var(--card,#fff);color:var(--ink,#1c2430);font-size:13px;font-weight:600;line-height:1.5;cursor:pointer;background:var(--action,#225dce);border-color:var(--action,#225dce);color:#fff}.ds-primary:hover{filter:brightness(.96)}.ds-primary:focus-visible{outline:3px solid var(--focus,#153f99);outline-offset:4px;}@media(prefers-color-scheme:dark){.ds-primary{background:#426fca;border-color:#426fca}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet supporting action.",
      "html": "<button class=\"ds-secondary\">Watch video</button>",
      "css": ".ds-secondary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;box-sizing:border-box;min-height:42px;padding:9px 15px;border:1px solid var(--border,#e3e7ee);border-radius:7px;background:var(--card,#fff);color:var(--ink,#1c2430);font-size:13px;font-weight:600;line-height:1.5;cursor:pointer;}.ds-secondary:hover{filter:brightness(.96)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#153f99);outline-offset:4px;}"
    },
    {
      "name": "Service card",
      "kind": "card",
      "refersTo": "service-card",
      "description": "Rounded directory surface with disclosure.",
      "html": "<details class=\"ds-service\"><summary>Payroll</summary><p>Salary slips, reimbursements &amp; claims</p></details>",
      "css": ".ds-service{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;background:var(--card,#fff);color:var(--ink,#1c2430);border:1px solid var(--border,#e3e7ee);border-radius:14px;overflow:hidden}.ds-service summary{box-sizing:border-box;min-height:88px;padding:18px 24px;font-size:16px;font-weight:650;line-height:1.4;cursor:pointer}.ds-service summary:hover{background:var(--bg,#f4f6f9)}.ds-service summary:focus-visible{outline:3px solid var(--focus,#153f99);outline-offset:4px;}.ds-service p{margin:0;padding:0 24px 24px;color:var(--sub,#5b6675);font-size:14px}"
    },
    {
      "name": "Support field",
      "kind": "input",
      "refersTo": "field",
      "description": "Labelled support category selector.",
      "html": "<label class=\"ds-label\" for=\"ds-category\">Category</label><select class=\"ds-field\" id=\"ds-category\"><option>Select category</option><option>Payroll</option></select>",
      "css": ".ds-label{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;display:block;color:var(--ink,#1c2430);font-size:13px;font-weight:600;margin-bottom:7px}.ds-field{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;width:100%;border:1px solid var(--border,#e3e7ee);border-radius:7px;background:var(--card,#fff);color:var(--ink,#1c2430);box-sizing:border-box;min-height:44px;padding:10px 12px;line-height:1.5}.ds-field:focus-visible{outline:3px solid var(--focus,#153f99);outline-offset:4px;}"
    },
    {
      "name": "Service tabs",
      "kind": "nav",
      "refersTo": "tab-active",
      "description": "Selected action text and accent underline.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab ds-selected\">Salary Slip</button><button class=\"ds-tab\">Reimbursement &amp; Claims</button></div>",
      "css": ".ds-tabs{display:flex;gap:24px;border-bottom:1px solid var(--border,#e3e7ee)}.ds-tab{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;padding:12px 0;border:0;background:none;color:var(--sub,#5b6675);font-size:13px;font-weight:600;box-sizing:border-box;min-height:45px;position:relative;text-align:left;cursor:pointer}.ds-selected{color:var(--action,#225dce)}.ds-selected:after{content:\"\";height:2px;background:var(--accent,#2f6feb);position:absolute;bottom:-1px;left:0;right:0;border-radius:2px}.ds-tab:focus-visible{outline:3px solid var(--focus,#153f99);outline-offset:4px;}"
    },
    {
      "name": "Information notice",
      "kind": "custom",
      "refersTo": "notice",
      "description": "Contextual guidance on a soft blue fill.",
      "html": "<div class=\"ds-notice\">Email routing is not configured yet. Contact your regional HR representative.</div>",
      "css": ".ds-notice{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;padding:14px 16px;border-radius:8px;background:var(--accent-soft,#e8f0fe);color:var(--ink,#1c2430);font-size:13px;line-height:1.6}"
    }
  ],
  "narrative": {
    "northStar": "Blue system UI",
    "overview": "A compact blue system interface helps employees find a service, read its guidance, and take an action. Rounded white or charcoal containers, restrained borders, and familiar controls carry the hierarchy.\n\nThe PRD pins the system font, blue palette, and device themes. This documentation records those shipped choices; it does not introduce an alternative visual identity.",
    "keyCharacteristics": [
      "Single-column service directory",
      "Blue action hierarchy and soft blue notices",
      "Flat bordered surfaces",
      "System typography and device themes"
    ],
    "rules": [
      {
        "name": "The Action Blue Rule",
        "body": "Use action blue for links and selected tabs; use the dedicated darker fill for primary buttons in the dark portal theme.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and tonal fills to distinguish surfaces; the shipped interface has no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve device light and dark variants when extending a component.",
      "Do keep keyboard focus visible and expose accordion and tab state semantically.",
      "Do use text to explain unavailable actions and contact information.",
      "Do keep the directory within its established single-column container."
    ],
    "donts": [
      "Don't add decorative elevation to the flat bordered containers.",
      "Don't introduce a display font; the system stack is explicitly pinned by the PRD.",
      "Don't use color alone to communicate calculation status or unavailable actions."
    ]
  }
}
